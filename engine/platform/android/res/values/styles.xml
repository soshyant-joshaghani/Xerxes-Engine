<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen (no status bar), and draw into the display cutout so a phone with a camera
         notch does not letterbox the editor with a black band beside it. The editor keeps its
         UI clear of the cutout and the navigation bar with the engine's SafeArea (see
         `modules::safe_area`, read into the editor's insets in `editor::stage::camera`). -->
    <style name="Theme.Xerxes" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
