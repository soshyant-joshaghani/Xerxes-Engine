 /// Additional methods on [`WindowAttributes`] that are specific to Android.
+/// Xerxes patch: the latest analog axes of a connected gamepad, which upstream winit would
+/// report as touches: `[left X, left Y, right X, right Y, left trigger, right trigger, hat X,
+/// hat Y]`, sticks and hat -1 to 1 (Android's y is down), triggers 0 to 1. Buttons and the
+/// D-pad also arrive as ordinary key events.
+pub fn gamepad_axes() -> [f32; 8] {
+    crate::platform_impl::gamepad_axes()
+}
