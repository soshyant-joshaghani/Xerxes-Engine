+impl MutationWriter<'_> {
+    /// Xerxes patch: forgets the element ids of nodes blitz freed since the last mutation. A freed
+    /// id is reused by the next node created, so a kept mapping would point at someone else's node.
+    fn forget_freed(&mut self) {
+        let freed = std::mem::take(&mut self.docm.doc.freed_nodes);
+        for node_id in freed {
+            for slot in self.state.node_id_mapping.iter_mut() {
+                if *slot == Some(node_id) {
+                    *slot = None;
+                }
+            }
+        }
+    }
+}
