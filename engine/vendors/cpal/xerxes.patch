+
+/// **Xerxes patch.** The web audio callback runs for as long as the page does, and every call it
+/// makes into the browser can fail: a context the browser closed or never allowed to start, a
+/// buffer it will not take. Upstream `.expect()`s those. A panic in wasm cannot be caught and
+/// poisons the instance, so one failed write there ends the **whole game**, not just its sound â€”
+/// a black page with `RuntimeError: unreachable`.
+///
+/// Here the first failure is reported to the console and the callback returns: no more sound from
+/// this stream, and the game plays on. See `engine/cpal/XERXES.md`.
+fn xerxes_audio_gave_up(what: &str, err: &wasm_bindgen::JsValue) {
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    static REPORTED: AtomicBool = AtomicBool::new(false);
+    if !REPORTED.swap(true, Ordering::Relaxed) {
+        web_sys::console::warn_2(
+            &wasm_bindgen::JsValue::from_str(&format!(
+                "cpal (Xerxes patch): could not {what}; this page is silent from here on"
+            )),
+            err,
+        );
+    }
+}
