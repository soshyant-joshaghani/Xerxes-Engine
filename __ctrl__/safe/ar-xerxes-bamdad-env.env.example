# Copy to ar-xerxes-bamdad-env.env and fill secrets.
# Must be >= 32 bytes for HS256. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=local-dev-only-replace-with-secrets-token-urlsafe-32
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=Admin@1234
POSTGRES_USER=postgres
POSTGRES_DB=app
POSTGRES_PASSWORD=change-me
# Traefik labels need DOMAIN (set to match compose.yml / DNS).
DOMAIN=example.com
