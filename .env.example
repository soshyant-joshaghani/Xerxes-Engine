# xerxes — copy to .env and fill in real values.
# Production URLs, CORS, domains, and PROJECT_NAME live in compose.yml — not here.
# The API and the worker read this file from the repo root when started on the host.

# Prod build: disable Bake (avoids "image …:prod already exists" on export).
COMPOSE_BAKE=false

SECRET_KEY=change-me
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=Admin@1234

# Host / IDE — published ports from compose.dev.yml
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PG@1234

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Browser origin allowed by CORS in dev. Optional: the engine page and <name>.play.localhost
# call /api same-origin. Without it the API uses the contract default (http://dashboard.localhost).
FRONTEND_HOST=http://engine.localhost
